{%- comment -%}
  Flis-editor: kunden laster opp eget bilde (hund/hytte), plasserer det og skriver navn.
  Legg seksjonen på en egen produktmal, og fjern temaets vanlige kjøpsknapper fra den malen.
  Filene flis-editor.js og flis-editor.css må ligge under «Assets» i temaet.
{%- endcomment -%}
{%- liquid
  assign p = product
  if p == blank and section.settings.product != blank
    assign p = all_products[section.settings.product]
  endif
-%}
{%- capture variants_json -%}
  [{%- for v in p.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price | money | strip_html | json }},"available":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
{%- endcapture -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Great+Vibes&family=Playfair+Display:wght@700&display=swap">
{{ 'flis-editor.css' | asset_url | stylesheet_tag }}

<div class="page-width flis-editor-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 style="text-align:center;">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <div style="text-align:center; max-width:560px; margin:0 auto 16px;">{{ section.settings.intro }}</div>
  {%- endif -%}

  {%- if p == blank -%}
    <p style="text-align:center;">Velg et produkt i seksjonens innstillinger.</p>
  {%- else -%}
    <div
      data-flis-editor
      data-preset="{{ section.settings.preset }}"
      data-variants="{{ variants_json | strip | escape }}"
      data-cart-url="{{ routes.cart_url }}"
    ></div>
  {%- endif -%}
</div>

<script src="{{ 'flis-editor.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Flis-editor (eget bilde)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "preset",
      "label": "Motiv / stil",
      "options": [
        { "value": "hund", "label": "Hund" },
        { "value": "hytte", "label": "Hytte" }
      ],
      "default": "hund"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produkt (bare nødvendig hvis seksjonen ikke ligger på en produktside)"
    },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Lag din egen flis" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introtekst",
      "default": "<p>Last opp et bilde, plasser det i ruten og legg gjerne til et navn. Vi graverer det på en 20 × 20 cm keramisk flis.</p>"
    },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "presets": [
    { "name": "Flis-editor (eget bilde)" }
  ]
}
{% endschema %}
