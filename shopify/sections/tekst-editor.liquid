{%- comment -%}
  Tekst-editor: kunden skriver én eller to linjer, velger skrift og ser graveringen
  på produktet (f.eks. personlig vinåpner). Legg seksjonen på en egen produktmal,
  og fjern temaets vanlige kjøpsknapper fra den malen.
  Krever assets: tekst-editor.js, flis-editor.css, skriftfilene (.woff) og produktbildet.
{%- endcomment -%}
{%- liquid
  assign p = product
  if p == blank and section.settings.product != blank
    assign p = all_products[section.settings.product]
  endif
-%}
{%- capture variants_json -%}
  [{%- for v in p.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price | money | strip_html | json }},"available":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
{%- endcapture -%}
{%- capture assets_json -%}
  {"image":{{ section.settings.image_asset | asset_url | json }},"fonts":{
    "script":{{ 'great-vibes-latin-400-normal.woff' | asset_url | json }},
    "dancing":{{ 'dancing-script-latin-700-normal.woff' | asset_url | json }},
    "serif":{{ 'playfair-display-latin-700-normal.woff' | asset_url | json }},
    "roman":{{ 'cinzel-latin-700-normal.woff' | asset_url | json }},
    "sans":{{ 'montserrat-latin-600-normal.woff' | asset_url | json }}}}
{%- endcapture -%}

{{ 'flis-editor.css' | asset_url | stylesheet_tag }}

<div id="lag-gravering" class="page-width tekst-editor-section" style="scroll-margin-top: 80px; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 style="text-align:center;">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <div style="text-align:center; max-width:560px; margin:0 auto 16px;">{{ section.settings.intro }}</div>
  {%- endif -%}
  {%- if p == blank -%}
    <p style="text-align:center;">Velg et produkt i seksjonens innstillinger.</p>
  {%- else -%}
    <div style="max-width:560px; margin:0 auto;">
      <div
        data-tekst-editor
        data-product="{{ section.settings.product_type }}"
        data-variants="{{ variants_json | strip | escape }}"
        data-assets="{{ assets_json | strip | escape }}"
        data-cart-url="{{ routes.cart_url }}"
      ><p style="text-align:center; padding:40px 0; opacity:.7;">Laster graveringsverktøyet …</p></div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'tekst-editor.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Tekst-editor (gravering)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "product_type",
      "label": "Produkt / gravérfelt",
      "options": [
        { "value": "korketrekker", "label": "Vinåpner / korketrekker (50 × 9 mm)" }
      ],
      "default": "korketrekker"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Produktbilde (filnavn under Assets)",
      "default": "korketrekker-tom.jpg"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produkt (bare nødvendig hvis seksjonen ikke ligger på en produktside)"
    },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Lag din gravering" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introtekst",
      "default": "<p>Skriv inn teksten og velg skrift. Du ser med en gang hvordan graveringen blir.</p>"
    },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [
    { "name": "Tekst-editor (gravering)" }
  ]
}
{% endschema %}
