{%- comment -%}
  Dørskilt-editor: kunden skriver topptekst (+ valgfri linje 2), velger motiv og skriver
  navn (to linjer), og ser dørskiltet. Krever assets: dorskilt-editor.js og flis-editor.css.
  Lenken «_SVG-fil» peker til siden svg-eksport.
{%- endcomment -%}
{%- liquid
  assign p = product
  if p == blank and section.settings.product != blank
    assign p = all_products[section.settings.product]
  endif
-%}
{%- capture variants_json -%}
  [{%- for v in p.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price | money | strip_html | json }},"available":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
{%- endcapture -%}

{{ 'flis-editor.css' | asset_url | stylesheet_tag }}

<div id="lag-dorskilt" class="page-width dorskilt-editor-section" style="scroll-margin-top: 80px; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 style="text-align:center;">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <div style="text-align:center; max-width:560px; margin:0 auto 16px;">{{ section.settings.intro }}</div>
  {%- endif -%}
  {%- if p == blank -%}
    <p style="text-align:center;">Velg et produkt i seksjonens innstillinger.</p>
  {%- else -%}
    <div style="max-width:560px; margin:0 auto;">
      <div
        data-dorskilt-editor
        data-variants="{{ variants_json | strip | escape }}"
        data-cart-url="{{ routes.cart_url }}"
        data-export-url="{{ shop.url }}/pages/{{ section.settings.export_page }}"
      ><p style="text-align:center; padding:40px 0; opacity:.7;">Laster dørskilt-verktøyet …</p></div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'dorskilt-editor.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Dørskilt-editor",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt (bare nødvendig hvis seksjonen ikke ligger på en produktside)" },
    { "type": "text", "id": "export_page", "label": "Handle til SVG-eksportsiden (lenken på ordren)", "default": "svg-eksport" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Lag ditt dørskilt" },
    { "type": "richtext", "id": "intro", "label": "Introtekst",
      "default": "<p>Skriv topptekst og navn, og velg motiv. Du ser med en gang hvordan dørskiltet blir.</p>" },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [{ "name": "Dørskilt-editor" }]
}
{% endschema %}
