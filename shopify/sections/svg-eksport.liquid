{%- comment -%}
  SVG-eksport for tekstbestillinger. Siden åpnes fra lenken «_SVG-fil» på ordren.
  Oppskriften ligger i lenken (#…), og siden lager SVG (vektor, mm) og PNG til LightBurn.
  Siden er ikke lenket fra menyen. Den viser bare det som står i lenken, og har ingen kundedata.
{%- endcomment -%}
{{ 'flis-editor.css' | asset_url | stylesheet_tag }}
<div class="page-width" style="padding: 32px 0 64px;">
  <h1 style="text-align:center; font-size: 1.6em;">{{ section.settings.heading | escape }}</h1>
  <div style="max-width:620px; margin:0 auto;">
    <div data-svg-eksport><p style="text-align:center; opacity:.7;">Laster …</p></div>
  </div>
</div>
<script src="{{ 'svg-eksport.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "SVG-eksport (gravering)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Graveringsfil til LightBurn" }
  ],
  "presets": [{ "name": "SVG-eksport (gravering)" }]
}
{% endschema %}
