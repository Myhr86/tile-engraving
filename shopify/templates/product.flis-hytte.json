{
  "sections": {
    "main": {
      "type": "product-information",
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "carousel",
            "media_columns": "two",
            "image_gap": 1,
            "large_first_image": false,
            "icons_style": "arrows",
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "dots",
            "thumbnail_position": "bottom",
            "thumbnail_width": 48,
            "aspect_ratio": "1",
            "constrain_to_viewport": true,
            "media_radius": 0,
            "extend_media": false,
            "zoom": true,
            "video_loop": true,
            "hide_variants": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "custom_width": 75,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "gap": 20,
            "sticky_details_desktop": true,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 18,
            "padding-block-end": 48,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "group_main": {
              "type": "group",
              "name": "t:names.group",
              "settings": {
                "vertical_on_mobile": true,
                "align_baseline": false,
                "width": "fill",
                "custom_width": 65,
                "width_mobile": "fill",
                "custom_width_mobile": 100,
                "height": "fit",
                "custom_height": 100,
                "background_media": "none",
                "video_position": "cover",
                "background_image_position": "cover",
                "toggle_overlay": false,
                "overlay_color": "#00000026",
                "overlay_style": "solid",
                "gradient_direction": "to top",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "link": "",
                "open_in_new_tab": false,
                "content_direction": "column",
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "horizontal_alignment_flex_direction_column": "flex-start",
                "vertical_alignment_flex_direction_column": "center",
                "gap": 28,
                "padding-block-start": 40,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "group_header": {
                  "type": "group",
                  "name": "Header",
                  "settings": {
                    "vertical_on_mobile": true,
                    "align_baseline": false,
                    "width": "fill",
                    "custom_width": 100,
                    "width_mobile": "fill",
                    "custom_width_mobile": 100,
                    "height": "fit",
                    "custom_height": 100,
                    "background_media": "none",
                    "video_position": "cover",
                    "background_image_position": "cover",
                    "toggle_overlay": false,
                    "overlay_color": "#00000026",
                    "overlay_style": "solid",
                    "gradient_direction": "to top",
                    "border": "none",
                    "border_width": 1,
                    "border_opacity": 100,
                    "border_radius": 0,
                    "link": "",
                    "open_in_new_tab": false,
                    "content_direction": "column",
                    "horizontal_alignment": "flex-start",
                    "vertical_alignment": "flex-start",
                    "horizontal_alignment_flex_direction_column": "flex-start",
                    "vertical_alignment_flex_direction_column": "center",
                    "gap": 8,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {
                    "title": {
                      "type": "text",
                      "settings": {
                        "text": "<h1>{{ closest.product.title }}</h1>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "h2",
                        "font": "var(--font-primary--family)",
                        "font_size": "",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "wrap": "pretty",
                        "background": false,
                        "background_color": "#00000026",
                        "corner_radius": 0,
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    },
                    "price": {
                      "type": "price",
                      "settings": {
                        "show_sale_price_first": true,
                        "show_installments": true,
                        "show_tax_info": true,
                        "type_preset": "h5",
                        "width": "100%",
                        "alignment": "left",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
                        "padding-block-start": 4,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "title",
                    "price"
                  ]
                },
                "divider": {
                  "type": "_divider",
                  "name": "t:names.divider",
                  "settings": {
                    "thickness": 1,
                    "corner_radius": "square",
                    "width_percent": 100,
                    "padding-block-start": 0,
                    "padding-block-end": 0
                  },
                  "blocks": {}
                },
                "description": {
                  "type": "product-description",
                  "settings": {
                    "text": "{{ closest.product.description }}",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "paragraph",
                    "font": "var(--font-primary--family)",
                    "font_size": "",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {},
                  "name": "Product description"
                },
                "flis_link": {
                  "type": "text",
                  "settings": {
                    "text": "<p><a href=\"#lag-flis\"><strong>Last opp bilde av hytta di ↓</strong></a></p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "paragraph",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                },
                "accordion": {
                  "type": "accordion",
                  "name": "t:names.accordion",
                  "settings": {
                    "icon": "plus",
                    "dividers": true,
                    "type_preset": "h5",
                    "border": "none",
                    "border_width": 1,
                    "border_opacity": 100,
                    "border_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {
                    "row": {
                      "type": "_accordion-row",
                      "settings": {
                        "heading": "BESTILLINGER OG RETURER",
                        "open_by_default": false
                      },
                      "blocks": {
                        "row_text": {
                          "type": "text",
                          "settings": {
                            "text": "<p>Vi jobber raskt og grundig for å behandle og sende alle bestillinger, slik at varene dine er på vei til deg så snart som mulig. Trenger du å returnere noe? Bare gi oss beskjed.</p>",
                            "width": "100%",
                            "max_width": "normal",
                            "alignment": "left",
                            "type_preset": "rte",
                            "font": "var(--font-body--family)",
                            "font_size": "1rem",
                            "line_height": "normal",
                            "letter_spacing": "normal",
                            "case": "none",
                            "wrap": "pretty",
                            "background": false,
                            "background_color": "#00000026",
                            "corner_radius": 0,
                            "padding-block-start": 0,
                            "padding-block-end": 0,
                            "padding-inline-start": 0,
                            "padding-inline-end": 0
                          },
                          "blocks": {}
                        }
                      },
                      "block_order": [
                        "row_text"
                      ]
                    }
                  },
                  "block_order": [
                    "row"
                  ]
                }
              },
              "block_order": [
                "group_header",
                "divider",
                "description",
                "flis_link",
                "accordion"
              ]
            }
          },
          "block_order": [
            "group_main"
          ]
        }
      },
      "settings": {
        "content_width": "content-center-aligned",
        "desktop_media_position": "left",
        "equal_columns": true,
        "limit_details_width": true,
        "gap": 48,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 0,
        "padding-block-end": 20
      }
    },
    "flis_editor": {
      "type": "flis-editor",
      "settings": {
        "preset": "hytte",
        "heading": "Lag flisen med din hytte",
        "intro": "<p>Last opp et bilde av hytta, plasser det i ruten og legg gjerne til hyttenavnet. Vi graverer det på en 20 × 20 cm keramisk flis.</p>",
        "padding_top": 36,
        "padding_bottom": 60
      }
    }
  },
  "order": [
    "main",
    "flis_editor"
  ]
}